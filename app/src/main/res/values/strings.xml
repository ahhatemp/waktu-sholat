    <string name="battery_guide_title">Panduan Baterai</string>
    <string name="battery_guide_intro">Beberapa merek HP membatasi aplikasi di latar belakang sehingga alarm adzan bisa terlewat. Ikuti langkah berikut agar Waktu Sholat tetap berjalan.</string>
    <string name="battery_status_exempt">Aplikasi sudah dikecualikan dari optimasi baterai.</string>
    <string name="battery_status_not_exempt">Aplikasi belum dikecualikan dari optimasi baterai.</string>
    <string name="battery_status_explain">Pengecualian ini membuat sistem tidak menunda alarm adzan.</string>
    <string name="battery_exemption_action">Minta pengecualian</string>
    <string name="battery_brands_title">Langkah per merek</string>
    <string name="battery_guide_disclaimer">Nama menu dapat berbeda tergantung versi sistem. Jika alarm tetap terlewat, buka pengaturan aplikasi dan izinkan aktivitas latar belakang.</string>
    <string name="battery_brand_xiaomi">Xiaomi (MIUI/HyperOS)</string>
    <string name="battery_brand_oppo">Oppo (ColorOS)</string>
    <string name="battery_brand_vivo">Vivo (Funtouch OS/OriginOS)</string>
    <string name="battery_brand_samsung">Samsung (One UI)</string>
    <string name="battery_brand_realme">Realme (realme UI)</string>
    <string name="battery_xiaomi_step_1">Buka Pengaturan HP → Aplikasi → Kelola aplikasi → Waktu Sholat.</string>
    <string name="battery_xiaomi_step_2">Aktifkan Autostart dan izinkan aktivitas latar belakang.</string>
    <string name="battery_xiaomi_step_3">Di layar recent apps, tahan kartu aplikasi lalu pilih kunci.</string>
    <string name="battery_oppo_step_1">Buka Pengaturan → Aplikasi → Manajemen aplikasi → Waktu Sholat.</string>
    <string name="battery_oppo_step_2">Aktifkan Izinkan aktivitas latar belakang dan Izinkan pengaturan otomatis.</string>
    <string name="battery_oppo_step_3">Di layar recent apps, tahan kartu aplikasi lalu pilih Kunci.</string>
    <string name="battery_vivo_step_1">Buka Pengaturan → Aplikasi &amp; izin → Manajemen latar belakang.</string>
    <string name="battery_vivo_step_2">Pilih Waktu Sholat dan atur penggunaan latar belakang ke Izinkan.</string>
    <string name="battery_vivo_step_3">Aktifkan Autostart lewat iManager.</string>
    <string name="battery_samsung_step_1">Buka Pengaturan → Baterai → Batas penggunaan latar belakang.</string>
    <string name="battery_samsung_step_2">Tambahkan Waktu Sholat ke daftar aplikasi yang tidak pernah tidur.</string>
    <string name="battery_samsung_step_3">Matikan mode hemat daya untuk aplikasi ini.</string>
    <string name="battery_realme_step_1">Buka Pengaturan → Baterai → Optimasi aplikasi.</string>
    <string name="battery_realme_step_2">Pilih Waktu Sholat dan matikan optimasi baterai.</string>
    <string name="battery_realme_step_3">Aktifkan Autostart dan kunci aplikasi di recent apps.</string>

